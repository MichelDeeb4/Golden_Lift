# Supply secrets through the deployment secret mechanism. No credential values belong here.
MEDIA_STORAGE=filesystem
MEDIA_DELIVERY=stream
MEDIA_PUBLIC_ORIGIN=http://127.0.0.1:3003
CATALOG_SERVICE_URL=http://127.0.0.1:3002
MEDIA_STORAGE_ROOT=.local/media/private
MEDIA_SCRATCH_ROOT=.local/media/scratch
MEDIA_CLAMAV_HOST=127.0.0.1
MEDIA_CLAMAV_PORT=3310
MEDIA_PART_BYTES=8388608
MEDIA_IMAGE_BYTES=20971520
MEDIA_IMAGE_PIXELS=40000000
MEDIA_VIDEO_BYTES=262144000
MEDIA_VIDEO_SECONDS=600
MEDIA_PDF_BYTES=31457280
MEDIA_PDF_PAGES=200
MEDIA_ADMIN_SESSIONS=3
MEDIA_GLOBAL_SESSIONS=100
MEDIA_RESERVED_BYTES=10737418240
MEDIA_PENDING_JOBS=1000
MEDIA_SESSION_SECONDS=3600
MEDIA_GRANT_SECONDS=300
MEDIA_MAX_ATTEMPTS=5
MEDIA_IMAGE_WORKERS=1
MEDIA_VIDEO_WORKERS=1
MEDIA_PDF_WORKERS=1
# Required secrets: MEDIA_CATALOG_TOKEN, MEDIA_EVENT_SECRET, CATALOG_EVENT_SECRET.
# Relay secrets: MEDIA_BROKER_URL (Media), CATALOG_BROKER_URL (Catalog); separate broker users.
# S3: MEDIA_S3_BUCKET, MEDIA_S3_REGION, optional MEDIA_S3_ENDPOINT/MEDIA_S3_PATH_STYLE.
# Production additionally requires HTTPS origins, MEDIA_STORAGE=s3,
# MEDIA_S3_IMMUTABLE_POLICY_VERIFIED=true after provider testing.
# Native worker production: Linux, MEDIA_PROCESS_SANDBOX=bwrap,
# MEDIA_WORKER_ISOLATED=true only after cgroup/scratch/sandbox verification.
# Owning runtime DATABASE_URL and AWS credentials are supplied independently per role.
