{
  "name": "@business-platform/database",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.21.0"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  },
  "scripts": {
    "build": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.target.json",
    "typecheck": "prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.target.json --noEmit"
  }
}
