IDENTITY_DATABASE_URL=postgresql://golden_lift_identity_runtime:<password>@127.0.0.1:55432/golden_lift_identity
CATALOG_DATABASE_URL=postgresql://golden_lift_catalog_runtime:<password>@127.0.0.1:55432/golden_lift_catalog
MEDIA_DATABASE_URL=postgresql://golden_lift_media_runtime:<password>@127.0.0.1:55432/golden_lift_media
INQUIRIES_DATABASE_URL=postgresql://golden_lift_inquiries_runtime:<password>@127.0.0.1:55432/golden_lift_inquiries

# Backend overrides; local development reads existing .local/database.env URLs.
NODE_ENV=development
HOST=127.0.0.1
GATEWAY_PORT=3000
IDENTITY_PORT=3001
CATALOG_PORT=3002
MEDIA_PORT=3003
INQUIRIES_PORT=3004
DATABASE_POOL_MAX=5
ALLOWED_ORIGINS=http://127.0.0.1:8082
IDENTITY_SERVICE_URL=http://127.0.0.1:3001
CATALOG_SERVICE_URL=http://127.0.0.1:3002
MEDIA_SERVICE_URL=http://127.0.0.1:3003
INQUIRIES_SERVICE_URL=http://127.0.0.1:3004


# Identity HTTP/mail defaults. .env files are examples; process environment is injected explicitly.
STAFF_APP_URL=http://127.0.0.1:8082
IDENTITY_MAIL_TRANSPORT=local
IDENTITY_SESSION_SECONDS=28800
IDENTITY_INVITATION_SECONDS=86400
IDENTITY_RESET_SECONDS=1800
IDENTITY_PASSWORD_CONCURRENCY=4
# Development generates ignored .local/service-secrets.json with npm run auth:setup.
# Production needs distinct random base64url secrets (at least 32 bytes), HTTPS URLs and SMTP:
# IDENTITY_CSRF_SECRET=<secret>
# IDENTITY_SERVICE_CREDENTIALS={"catalog":"<secret>","media":"<secret>","inquiries":"<secret>"}
# CATALOG_IDENTITY_SERVICE_TOKEN=<catalog-secret>
# MEDIA_IDENTITY_SERVICE_TOKEN=<media-secret>
# INQUIRIES_IDENTITY_SERVICE_TOKEN=<inquiries-secret>
# SMTP_HOST=<provider-host>
# SMTP_PORT=465
# SMTP_USER=<provider-user>
# SMTP_PASSWORD=<provider-password>
# SMTP_FROM=<verified-sender-address>

