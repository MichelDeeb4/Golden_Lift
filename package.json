{
  "name": "golden-lift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "npm run format:check && node scripts/check-boundaries.mjs && node scripts/test-boundaries.mjs && npm run orm:check",
    "test": "npm run build && node scripts/test.mjs unit",
    "test:integration": "npm run build && node scripts/test.mjs integration",
    "check": "npm run build && npm run typecheck && npm run lint && node scripts/test.mjs unit",
    "dev": "node scripts/dev.mjs",
    "db:status": "node database/scripts/db.mjs status",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "format": "prettier --write \"services/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"scripts/*.mjs\" \"*.json\" \".github/workflows/*.yml\" \"documentation/api/*.json\" \"!services/*/src/infrastructure/prisma/generated/**\"",
    "format:check": "prettier --check \"services/**/*.{ts,json}\" \"packages/**/*.{ts,json}\" \"scripts/*.mjs\" \"*.json\" \".github/workflows/*.yml\" \"documentation/api/*.json\" \"!services/*/src/infrastructure/prisma/generated/**\"",
    "auth:setup": "node scripts/setup-auth.mjs",
    "api:sync": "node scripts/sync-openapi.mjs",
    "smoke:identity": "npm run build && node scripts/identity-smoke.mjs",
    "orm:generate": "node scripts/prisma.mjs generate",
    "orm:check": "node scripts/prisma.mjs validate",
    "orm:verify": "npm run build && node scripts/verify-orm.mjs",
    "orm:pull": "node scripts/prisma.mjs pull",
    "orm:format": "node scripts/prisma.mjs format",
    "db:dynamic": "node database/scripts/dynamic-catalog.mjs",
    "db:verify:dynamic": "node database/scripts/verify-dynamic.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "prisma": "7.10.0"
  }
}
